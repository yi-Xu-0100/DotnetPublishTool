<Window x:Class="DotnetPublishTool.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dotnet 发布工具" Height="880" Width="1240" MinHeight="720" MinWidth="1040"
        WindowStartupLocation="CenterScreen"
        Background="#FFF3F4F6"
        FontFamily="Microsoft YaHei UI" FontSize="13">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="130" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- 项目选择 -->
    <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,8">
      <StackPanel Grid.IsSharedSizeScope="True">
        <TextBlock Text="项目" Style="{StaticResource SectionHeader}" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" SharedSizeGroup="FieldLabel" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="项目/解决方案：" Style="{StaticResource FieldLabel}" />
          <TextBox Grid.Column="1" Text="{Binding ProjectPath, Mode=OneWay}" IsReadOnly="True" Background="#FFFBFBFB" />
          <Button Grid.Column="2" Content="选择…" Command="{Binding BrowseProjectCommand}" />
          <Button Grid.Column="3" Content="重新扫描" Command="{Binding RescanCommand}" />
        </Grid>
        <Grid Margin="0,8,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" SharedSizeGroup="FieldLabel" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="最近项目：" Style="{StaticResource FieldLabel}" />
          <ComboBox Grid.Column="1" ItemsSource="{Binding RecentProjects}" SelectedItem="{Binding SelectedRecentProject}"
                    DisplayMemberPath="DisplayName" ToolTip="{Binding SelectedRecentProject.FilePath}" />
          <Button Grid.Column="2" Content="清除记录" MinWidth="76" Command="{Binding ClearRecentProjectsCommand}" />
        </Grid>
        <Grid Margin="0,8,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" SharedSizeGroup="FieldLabel" />
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="项目：" Style="{StaticResource FieldLabel}" />
          <ComboBox Grid.Column="1" ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}" DisplayMemberPath="Name" />
          <TextBlock Grid.Column="2" Text="{Binding ProjectSummary}" Margin="12,0,0,0" VerticalAlignment="Center"
                     Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis" />
        </Grid>
      </StackPanel>
    </Border>

    <!-- 输出与打包 -->
    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,12,0">
          <TextBlock Text="输出" Style="{StaticResource SectionHeader}" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="输出根目录：" Style="{StaticResource FieldLabel}" />
            <TextBox Grid.Column="1" Text="{Binding OutputRoot, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="2" Content="浏览…" Command="{Binding BrowseOutputRootCommand}" />
          </Grid>
          <TextBlock Text="{Binding PublishDirectoryPreview, StringFormat=发布目录：{0}}" TextWrapping="Wrap"
                     Foreground="{StaticResource TextSecondary}" Margin="0,6,0,0" />
          <CheckBox Content="发布前清空发布目录" IsChecked="{Binding CleanPublishDirectory}" Margin="0,8,0,0" />
          <CheckBox Content="使用 --no-restore（已提前还原）" IsChecked="{Binding NoRestore}" Margin="0,4,0,0" />
        </StackPanel>

        <StackPanel Grid.Column="1" Margin="12,0,0,0">
          <TextBlock Text="压缩包" Style="{StaticResource SectionHeader}" />
          <CheckBox Content="发布成功后生成 zip 压缩包" IsChecked="{Binding MakeZip}" />
          <Grid Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="命名方式：" Style="{StaticResource FieldLabel}" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding ZipNamingModes}" DisplayMemberPath="Label"
                      SelectedValuePath="Value" SelectedValue="{Binding ZipNamingMode}" />
          </Grid>
          <Grid Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="日期格式：" Style="{StaticResource FieldLabel}" />
            <TextBox Grid.Column="1" Text="{Binding ZipDateFormat, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsDateNaming}" />
          </Grid>
          <Grid Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="自定义名称：" Style="{StaticResource FieldLabel}" />
            <TextBox Grid.Column="1" Text="{Binding CustomZipName, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsCustomNaming}" />
          </Grid>
          <CheckBox Content="压缩包内包含以项目名命名的顶层文件夹" IsChecked="{Binding ZipIncludeRootFolder}" Margin="0,8,0,0"
                    ToolTip="默认不勾选：解压出来就是文件本身；勾选后多一层以项目名命名的文件夹" />
          <TextBlock Text="{Binding ZipPathPreview, StringFormat=压缩包：{0}}" TextWrapping="Wrap"
                     Foreground="{StaticResource TextSecondary}" Margin="0,6,0,0" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- 配置与编辑 -->
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="280" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="发布配置" Style="{StaticResource SectionHeader}" />
          <TextBlock DockPanel.Dock="Bottom" Text="来自项目 Properties\PublishProfiles 目录"
                     Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="11" />
          <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="DisplayName" />
        </DockPanel>
      </Border>

      <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0" Padding="6">
        <TabControl BorderThickness="0" Background="Transparent">
          <TabItem Header="常用设置">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <Grid Margin="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="130" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="12" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="配置" Style="{StaticResource FieldLabel}" Margin="0,0,8,6" />
                <!-- 只用 Text 双向绑定：同时绑 SelectedItem 时，输入不在列表里的值时 SelectedItem 变 null 会清空输入。 -->
                <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,6" ItemsSource="{Binding Configurations}"
                          IsEditable="True"
                          Text="{Binding Configuration, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="目标框架" Style="{StaticResource FieldLabel}" Margin="0,0,8,6" />
                <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,6" ItemsSource="{Binding TargetFrameworks}"
                          IsEditable="True" Text="{Binding TargetFramework, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="运行时标识符" Style="{StaticResource FieldLabel}" Margin="0,0,8,6" />
                <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,6" ItemsSource="{Binding RuntimeIdentifiers}"
                          IsEditable="True" Text="{Binding RuntimeIdentifier, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="环境名" Style="{StaticResource FieldLabel}" Margin="0,0,8,6" />
                <TextBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,6" Text="{Binding EnvironmentName, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="4" Grid.Column="0" Text="版本覆盖" Style="{StaticResource FieldLabel}" Margin="0,0,8,6" />
                <TextBox Grid.Row="4" Grid.Column="1" Margin="0,0,0,6" Text="{Binding VersionOverride, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="留空表示使用项目自身版本" />

                <TextBlock Grid.Row="6" Grid.Column="0" Text="运行时依赖" Style="{StaticResource FieldLabel}" Margin="0,0,8,6" />
                <ComboBox Grid.Row="6" Grid.Column="1" Margin="0,0,0,6" ItemsSource="{Binding DeploymentModes}"
                          DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding SelfContained}" />

                <UniformGrid Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" Columns="2" Margin="0,4,0,0">
                  <CheckBox Content="单文件（PublishSingleFile）" IsChecked="{Binding PublishSingleFile}" Margin="0,2" />
                  <CheckBox Content="提前编译（PublishReadyToRun）" IsChecked="{Binding PublishReadyToRun}" Margin="0,2" />
                  <CheckBox Content="裁剪（PublishTrimmed）" IsChecked="{Binding PublishTrimmed}" Margin="0,2" />
                </UniformGrid>

                <TextBlock Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,10,0,0"
                           FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding PublishModeSummary}" />

                <TextBlock Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,6,0,0" TextWrapping="Wrap"
                           Foreground="{StaticResource TextSecondary}"
                           Text="版本覆盖留空时用项目自身版本；zip 版本号解析不到则用 unknown。发布命令由上方设置 + 「其他属性」共同决定。" />
              </Grid>
            </ScrollViewer>
          </TabItem>

          <TabItem Header="其他属性">
            <DockPanel Margin="6">
              <TextBlock DockPanel.Dock="Top" Margin="0,0,0,6" TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}"
                         Text="发布配置中除常用项以外的属性（如 Platform、PublishProtocol、_TargetId）。可直接编辑；最后一行可新增。" />
              <DataGrid ItemsSource="{Binding ExtraProperties}" AutoGenerateColumns="False"
                        CanUserAddRows="True" CanUserDeleteRows="True" HeadersVisibility="Column"
                        GridLinesVisibility="Horizontal" RowHeight="26" SelectionUnit="Cell">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="属性名" Width="260" Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}" />
                  <DataGridTextColumn Header="值" Width="*" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
          </TabItem>

          <TabItem Header="配置预览">
            <DockPanel Margin="6">
              <TextBlock DockPanel.Dock="Top" Margin="0,0,0,6" TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}"
                         Text="本次生效的配置副本内容（保存在输出目录的 profiles 子目录，不改动源文件）。" />
              <TextBox Text="{Binding ProfilePreviewXml, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
                       FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
            </DockPanel>
          </TabItem>
        </TabControl>
      </Border>
    </Grid>

    <!-- 日志 -->
    <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,8,0,0" Padding="10,8">
      <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
          <TextBlock Text="日志" Style="{StaticResource SectionHeader}" Margin="0" />
          <Button Content="清空" HorizontalAlignment="Right" MinWidth="60" Command="{Binding ClearLogCommand}" />
        </Grid>
        <TextBox x:Name="LogTextBox" Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True"
                 FontFamily="Consolas" FontSize="12" Background="#FF1E1E1E" Foreground="#FFE6E6E6"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 TextWrapping="NoWrap" AcceptsReturn="True" BorderThickness="0" />
      </DockPanel>
    </Border>

    <!-- 状态与操作 -->
    <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,8,0,0" Padding="10,6">
      <DockPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
          <Button Content="保存配置副本" Command="{Binding SaveProfileCommand}" />
          <Button Content="打开输出目录" Command="{Binding OpenOutputFolderCommand}" />
          <Button Content="取消" Command="{Binding CancelCommand}" />
          <Button Content="生成并发布" Command="{Binding PublishCommand}" FontWeight="Bold"
                  Background="{StaticResource Accent}" Foreground="White" MinWidth="110" />
        </StackPanel>
        <ProgressBar DockPanel.Dock="Right" Width="140" Height="14" Margin="10,0,0,0" IsIndeterminate="{Binding IsBusy}" />
        <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>
  </Grid>
</Window>
