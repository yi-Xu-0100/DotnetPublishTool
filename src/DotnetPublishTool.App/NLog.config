<?xml version="1.0" encoding="utf-8"?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      throwExceptions="false"
      internalLogLevel="Off">

  <!--
    工具自身日志。结构与 LaserMotionCardMap 的 NLog.config 一致（按等级分文件 + 调用点 + 归档策略），
    差异有三处，各有理由：
      1) 写路径用 %LOCALAPPDATA%，不用 ${basedir} —— 安装目录（Program Files）对普通用户只读，
         用 ${basedir} 会"有配置没日志"（就是给 LaserMotionCardMap 排查过的那条坑）；
      2) 归档按天（archiveEvery="Day"）而不是按小时：本工具每次只跑几分钟，按小时归档会碎成很多文件；
      3) 归档命名用 NLog 6 的 archiveSuffixFormat（archiveNumbering / archiveDateFormat / archiveFileName 里的
         {#} 自 6.0 起已弃用，archiveFileName 只在 legacy 迁移场景才需要）：当前文件固定为 tool.log / logfile.log，
         归档形如 tool_261111_00.log（日期 yyMMdd：按天归档时取被归档文件所属的那天，按大小归档时取归档当天；_NN 为序号）。
    另外**不套 AsyncWrapper**：崩溃时最后几行往往正是要看的，异步队列会把它们丢掉。
    等级分工：Info 及以上进 tool.log（归档 tool_<yymmdd>_<序号>.log）；Debug（含 [诊断]）单独进 debug/；Error 再抄一份进 error/。
    只想看常规信息：把下面 debug 那条规则删掉即可，不用改代码。
  -->
  <variable name="LogRoot" value="${specialfolder:folder=LocalApplicationData}/DotnetPublishTool/logs" />
  <variable name="LogLayout" value="[${date:format=MM-ddTHH\:mm\:ss.fff}] [${level:uppercase=true}] [${callsite:className=false:includeNamespace=false:fileName=true:includeSourcePath=false:methodName=false}] ${message} ${exception}" />

  <targets>
    <!-- 常规：Info 及以上 -->
    <target xsi:type="File" name="infoFileTarget"
            fileName="${LogRoot}/tool.log"
            layout="${LogLayout}"
            encoding="utf-8"
            keepFileOpen="false"
            archiveEvery="Day"
            archiveAboveSize="5242880"
            archiveSuffixFormat="_{1:yyMMdd}_{0:00}"
            maxArchiveFiles="60"
            maxArchiveDays="30" />

    <!-- 细节：Debug（含 [诊断] 行），单独放，免得把常规日志刷满 -->
    <target xsi:type="File" name="debugFileTarget"
            fileName="${LogRoot}/debug/logfile.log"
            layout="${LogLayout}"
            encoding="utf-8"
            keepFileOpen="false"
            archiveEvery="Day"
            archiveAboveSize="5242880"
            archiveSuffixFormat="_{1:yyMMdd}_{0:00}"
            maxArchiveFiles="30"
            maxArchiveDays="14" />

    <!-- 错误：再抄一份，便于现场直接看这份 -->
    <target xsi:type="File" name="errorFileTarget"
            fileName="${LogRoot}/error/logfile.log"
            layout="${LogLayout}"
            encoding="utf-8"
            keepFileOpen="false"
            archiveEvery="Day"
            archiveAboveSize="2097152"
            archiveSuffixFormat="_{1:yyMMdd}_{0:00}"
            maxArchiveFiles="20"
            maxArchiveDays="30" />
  </targets>

  <rules>
    <!-- 等级区间互不重叠，避免同一条日志写两遍；错误那条是有意叠加的副本 -->
    <logger name="*" minlevel="Trace" maxlevel="Debug" writeTo="debugFileTarget" />
    <logger name="*" minlevel="Info" writeTo="infoFileTarget" />
    <logger name="*" minlevel="Error" writeTo="errorFileTarget" />
  </rules>
</nlog>
